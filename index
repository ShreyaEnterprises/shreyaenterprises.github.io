<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SteelFlow Mechanical Piping Workshop</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- ===== HEADER / NAVBAR ===== -->
    <header>
        <div class="container">
            <h1 class="logo">SteelFlow</h1>
            <nav>
                <ul class="nav-links">
                    <li><a href="#home">Home</a></li>
                    <li><a href="#about">About</a></li>
                    <li><a href="#services">Services</a></li>
                    <li><a href="#projects">Projects</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- ===== HERO SECTION ===== -->
    <section id="home" class="hero">
        <div class="hero-content">
            <h2>Precision Piping Solutions</h2>
            <p>Expert fabrication, installation, and maintenance of mechanical piping systems.</p>
            <a href="#contact" class="btn">Get a Quote</a>
        </div>
    </section>

    <!-- ===== ABOUT SECTION ===== -->
    <section id="about" class="section">
        <div class="container">
            <h2>About Us</h2>
            <p>SteelFlow Workshop specializes in mechanical and industrial piping systems. With over 15 years of experience, we provide custom fabrication, welding, and installation for various industries — ensuring safety, reliability, and performance.</p>
        </div>
    </section>

    <!-- ===== SERVICES SECTION ===== -->
    <section id="services" class="section bg-light">
        <div class="container">
            <h2>Our Services</h2>
            <div class="service-grid">
                <div class="service-card">
                    <h3>Piping Fabrication</h3>
                    <p>Custom stainless steel and carbon steel piping built to client specifications.</p>
                </div>
                <div class="service-card">
                    <h3>Welding & Inspection</h3>
                    <p>Certified welders ensuring precision joints and long-lasting durability.</p>
                </div>
                <div class="service-card">
                    <h3>Installation & Maintenance</h3>
                    <p>Expert installation and ongoing maintenance for industrial facilities.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== PROJECTS SECTION ===== -->
    <section id="projects" class="section">
        <div class="container">
            <h2>Recent Projects</h2>
            <div class="project-grid">
                <div class="project-card"><img src="https://via.placeholder.com/300x200" alt="Project 1"><p>Oil Refinery Pipeline Installation</p></div>
                <div class="project-card"><img src="https://via.placeholder.com/300x200" alt="Project 2"><p>Cooling System Fabrication</p></div>
                <div class="project-card"><img src="https://via.placeholder.com/300x200" alt="Project 3"><p>Food Processing Line Upgrade</p></div>
            </div>
        </div>
    </section>

    <!-- ===== CONTACT SECTION ===== -->
    <section id="contact" class="section bg-light">
        <div class="container">
            <h2>Contact Us</h2>
            <p>Get in touch for estimates, project inquiries, or service requests.</p>
            <form class="contact-form">
                <input type="text" placeholder="Your Name" required>
                <input type="email" placeholder="Email Address" required>
                <textarea placeholder="Your Message" required></textarea>
                <button type="submit" class="btn">Send Message</button>
            </form>
        </div>
    </section>

    <!-- ===== FOOTER ===== -->
    <footer>
        <p>&copy; 2025 SteelFlow Mechanical Piping Workshop. All rights reserved.</p>
    </footer>
</body>
</html>
