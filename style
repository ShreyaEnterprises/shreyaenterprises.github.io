/* ===== RESET ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Segoe UI", sans-serif;
}

/* ===== GLOBAL ===== */
body {
    color: #333;
    line-height: 1.6;
}

.container {
    width: 90%;
    max-width: 1100px;
    margin: auto;
}

.section {
    padding: 60px 0;
    text-align: center;
}

.bg-light {
    background-color: #f4f4f4;
}

h2 {
    margin-bottom: 20px;
    color: #004a7c;
}

/* ===== HEADER ===== */
header {
    background: #004a7c;
    color: #fff;
    padding: 15px 0;
    position: sticky;
    top: 0;
    z-index: 1000;
}

header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 1.5em;
    font-weight: bold;
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 20px;
}

.nav-links a {
    color: #fff;
    text-decoration: none;
    font-weight: 500;
}

.nav-links a:hover {
    text-decoration: underline;
}

/* ===== HERO SECTION ===== */
.hero {
    background: url('https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=1500&q=80') center/cover no-repeat;
    color: #fff;
    height: 80vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
}

.hero::after {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.5);
}

.hero-content {
    position: relative;
    z-index: 1;
}

.hero h2 {
    font-size: 2.5em;
    margin-bottom: 10px;
}

.btn {
    background: #ffb400;
    color: #000;
    padding: 10px 25px;
    text-decoration: none;
    border-radius: 4px;
    font-weight: bold;
    display: inline-block;
}

.btn:hover {
    background: #ffc933;
}

/* ===== SERVICES ===== */
.service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 30px;
}

.service-card {
    background: #fff;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

/* ===== PROJECTS ===== */
.project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 30px;
}

.project-card img {
    width: 100%;
    border-radius: 5px;
}

.project-card p {
    margin-top: 10px;
    font-weight: 500;
}

/* ===== CONTACT ===== */
.contact-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    max-width: 500px;
    margin: 30px auto 0;
}

.contact-form input,
.contact-form textarea {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    resize: none;
}

.contact-form button {
    align-self: center;
}

/* ===== FOOTER ===== */
footer {
    background: #004a7c;
    color: #fff;
    text-align: center;
    padding: 20px;
    margin-top: 30px;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
    .nav-links {
        flex-direction: column;
        background: #003a63;
        position: absolute;
        top: 60px;
        right: 0;
        width: 200px;
        display: none;
    }
}
